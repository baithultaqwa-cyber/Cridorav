# Copy to `.env` locally (not committed). On Railway, set as variables in the API service.
#
# Core Django. DEBUG defaults to FALSE (secure by default) — you MUST set this to true for local
# development, otherwise Django will require a real DJANGO_SECRET_KEY and disable debug pages.
DJANGO_DEBUG=true
# Required in production (DJANGO_DEBUG=false). Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# DJANGO_SECRET_KEY=
# Comma-separated public hostnames the app serves (required in production).
# DJANGO_ALLOWED_HOSTS=cridorav-production.up.railway.app
# Comma-separated https origins for CSRF (admin/session forms) in production.
# CSRF_TRUSTED_ORIGINS=https://cridorav-production.up.railway.app
#
# Stripe — https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_ / pk_test_) until go-live, then sk_live_ / pk_live_.
STRIPE_SECRET_KEY=
# Webhook signing secret for POST /api/webhooks/stripe/ (from Dashboard or `stripe listen`)
STRIPE_WEBHOOK_SECRET=
# Optional. Same as Dashboard “Publishable key”. Exposed in order API when card checkout is on.
STRIPE_PUBLISHABLE_KEY=
# Set true only in dev to POST paid without card when STRIPE_SECRET_KEY is set.
# STRIPE_ALLOW_MANUAL_MARK_PAID=false
#
# Public URL of the browser app (no trailing slash). Used for Stripe Checkout success/cancel and
# password-reset links. If omitted, the same value as DJANGO_PUBLIC_BASE_URL is used (one Railway
# service for SPA + API), then RAILWAY_PUBLIC_DOMAIN, then localhost (with a warning in production).
# FRONTEND_BASE_URL=https://cridorav-production.up.railway.app
#
# DJANGO_PUBLIC_BASE_URL=https://cridorav-production.up.railway.app
#
# Leave unset/false in production. When true, the two seed_users.py accounts
# (customer@example.com, vendor@emiratesgold.com) get hardcoded showcase data on their
# dashboard instead of their real orders — marketing/screenshot use only. A real signup with
# either exact email would see fake data if this were left on.
# CRIDORA_DEMO_MODE=false
#
# Cridora admin (Railway Variables → redeploy). Applied by `manage.py bootstrap_admin` on web start.
# CRIDORA_ADMIN_USER_ID=
# CRIDORA_ADMIN_EMAIL=
# CRIDORA_ADMIN_USERNAME=
# CRIDORA_ADMIN_PASSWORD=
# (aliases: DJANGO_BOOTSTRAP_ADMIN_EMAIL / USERNAME / PASSWORD / USER_ID)
#
# Shared cache (Railway Redis plugin → REDIS_URL). Required before scaling beyond one
# Gunicorn worker / replica — login lockout, DRF throttles, and spot cache all use it.
# Local/dev: leave unset to use in-process LocMemCache.
# REDIS_URL=redis://default:password@host:6379
#
# Login lockout (email + IP). Defaults: 8 failures → 15 minute lock.
# LOGIN_LOCKOUT_ATTEMPTS=8
# LOGIN_LOCKOUT_SECONDS=900
#
# Optional: restrict Django admin (/monkey123/) to office/VPN IPs (comma-separated).
# DJANGO_ADMIN_ALLOWED_IPS=
#
# Database backups: python manage.py backup_cridora  (or RUN_MODE=backup_cron)
# BACKUP_DIR=/app/backups
# BACKUP_INTERVAL_HOURS=24
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=cridora-backups
#
# HSTS: off (0) by default. Enable only after confirming HTTPS is stable in production — start
# small (e.g. 3600 = 1 hour) and raise toward 31536000 (1 year) as confidence grows.
# DJANGO_HSTS_SECONDS=0
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_HSTS_PRELOAD=false
#
# Web Push (VAPID) — tray notifications for PWA on Android / iOS (Add to Home Screen).
# Generate: npx web-push generate-vapid-keys
# `WEB_PUSH_VAPID_PUBLIC_KEY` / `WEB_PUSH_VAPID_PRIVATE_KEY` / `WEB_PUSH_VAPID_CONTACT` are also
# accepted (checked as a fallback in settings.py) — use whichever pair you already set on Railway.
# Private key may be raw base64url OR a PEM string (real or literal "\n"-escaped newlines both work).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CLAIMS_EMAIL=mailto:noreply@cridora.com
#
# SMS OTP fallback for httpSMS (admin can switch provider in dashboard → Fees & Config).
# HTTPSMS_API_KEY=
# HTTPSMS_FROM_NUMBER=+9715XXXXXXXX
#
# Zoho Mail SMTP for email OTP / password reset (also used by ForgotPasswordView).
# EMAIL_HOST=smtp.zoho.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=noreply@cridora.com
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@cridora.com
#
# Google Cloud Vision AML assist (server-side only; optional).
# GOOGLE_VISION_API_KEY=
#
# Price movement alerts (Railway Cron: python manage.py check_price_alerts every 5–15 min)
# PRICE_ALERT_THRESHOLD_AED=10
# PRICE_ALERT_THRESHOLD_PCT=1.0
# PRICE_ALERT_COOLDOWN_MINUTES=30
